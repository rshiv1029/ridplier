{
  "manifest_version": 3,
  "name": "Ridplier Auto-Fill (PA Job Helper)",
  "version": "1.0.0",
  "description": "One-click local auto-fill for Workday, Oracle Cloud, iCIMS, Radancy, and hospital PA career portals.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ridplier PA Auto-Fill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
